---
import '@fontsource-variable/noto-sans-jp';
import '../styles/global.css';
import SubTitle from '../ui/parts/SubTitle.astro';
import NewsItemList from '../ui/components/NewsItemList.astro';
import UpcomingWeatherItemList from '../ui/components/UpcomingWeatherItemList.astro';
import TodayWeather from '../ui/components/TodayWeather.astro';
import TodayWeatherDetail from '../ui/components/TodayWeatherDetail.astro';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>ui</title>
  </head>

  <body>
    <!-- root -->
    <div class="flex h-screen w-full flex-col gap-6 p-2">
      <!-- today -->
      <div>
        <div class="flex justify-between">
          <SubTitle text="12/11(木)" />
          <div>更新: 8:15</div>
        </div>
        <div class="flex justify-between">
          <TodayWeather />
          <TodayWeatherDetail />
        </div>
      </div>

      <!-- 今日これから -->
      <div class="">
        <SubTitle text="今後の天気" />
        <UpcomingWeatherItemList
          items={[
            {
              datetime: '12:00',
              weather: 'sunny',
              temp: 20,
            },
            {
              datetime: '15:00',
              weather: 'cloudy',
              temp: 19,
            },
            {
              datetime: '18:00',
              weather: 'rainy',
              temp: 17,
            },
            {
              datetime: '21:00',
              weather: 'rainy',
              temp: 16,
            },
            {
              datetime: '24:00',
              weather: 'cloudy',
              temp: 15,
            },
            {
              datetime: '3:00',
              weather: 'sunny',
              temp: 14,
            },
          ]}
        />
      </div>

      <!-- news -->
      <div>
        <SubTitle text="ニュース" />
        <NewsItemList
          items={[
            {
              title:
                'ニュースタイトル1ニュースタイトル1ニュースタイトル1ニュースタイトル1ニュースタイトル1ニュースタイトル1ニュースタイトル1ニュースタイトル1ニュースタイトル1ニュースタイトル1ニュースタイトル1ニュースタイトル1ニュースタイトル1ニュースタイトル1ニュースタイトル1ニュースタイトル1',
              url: 'https://example.com/news1',
            },
            {
              title: 'ニュースタイトル2',
              url: 'https://example.com/news2',
            },
          ]}
        />
      </div>
    </div>
  </body>
</html>
