---
import dayjs from 'dayjs';
import BaseLayout from '../layouts/BaseLayout.astro';

import SubTitle from '../ui/parts/SubTitle.astro';
import NewsItemList from '../ui/components/NewsItemList.astro';
import UpcomingWeatherItemList from '../ui/components/UpcomingWeatherItemList.astro';
import CurrentWeather from '../ui/components/CurrentWeather.astro';
import CurrentWeatherDetail from '../ui/components/CurrentWeatherDetail.astro';

import { getNews } from '../services/newsService';
import { getWeather } from '../services/weatherService';

const news = await getNews();
const weather = await getWeather(42.9238, 143.1966);
const now = dayjs();
---

<BaseLayout>
  <!-- root -->
  <div class="flex h-screen w-full flex-col justify-between p-4">
    <!-- today -->
    <div class="bg-yellow-100">
      <div class="flex justify-between">
        <SubTitle text={now.format('MM/DD (ddd)')} />
        <div>{`更新: ${now.format('HH:mm')}`}</div>
      </div>
      <div class="flex justify-between">
        <CurrentWeather
          icon={weather.current.icon}
          temperature={weather.current.temp}
          description={weather.current.description}
        />
        <CurrentWeatherDetail
          alerts={weather.alerts.map((alert) => {
            return alert.event;
          })}
        />
      </div>
    </div>

    <!-- 今日これから -->
    <div class="bg-blue-100">
      <SubTitle text="今後の天気" />
      <UpcomingWeatherItemList
        items={weather.hourly.map((item) => ({
          date: item.date.format('HH:mm'),
          icon: item.icon,
          temp: item.temp,
        }))}
      />
    </div>

    <!-- news -->
    <div class="bg-green-100">
      <SubTitle text="ニュース" />
      <NewsItemList items={news} />
    </div>
  </div>
</BaseLayout>
