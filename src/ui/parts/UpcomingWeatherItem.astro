---
import WeatherIcon from './WeatherIcon.astro';

interface Props {
  datetime: string;
  weather?: 'sunny' | 'cloudy' | 'rainy';
  temp: number;
}

const { datetime, weather, temp } = Astro.props;
---

<div class="flex flex-col items-center">
  <div>{datetime}</div>
  <WeatherIcon size="small" />
  <div>{`${temp}°C`}</div>
</div>
