---
import UpcomingWeatherItem from '../parts/UpcomingWeatherItem.astro';

interface Props {
  items: Array<{
    datetime: string;
    weather?: 'sunny' | 'cloudy' | 'rainy';
    temp: number;
  }>;
}

const { items } = Astro.props;
---

<div class="flex w-full justify-around">
  {
    items.map((item) => (
      <UpcomingWeatherItem datetime={item.datetime} weather={item.weather} temp={item.temp} />
    ))
  }
</div>
